# Django Environment Variables Template
SECRET_KEY=your-super-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://flavourholidays.onrender.com

# Database (PostgreSQL provided automatically on Render via DATABASE_URL)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Cloudinary media storage (required in production / DEBUG=False)
# Option A (recommended): single URL from the Cloudinary dashboard
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Option B: separate variables (all three required if CLOUDINARY_URL is unset)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
#
# If both Option A and B are set, the three explicit variables win.
# Keep them in sync with the same Cloudinary product environment.
